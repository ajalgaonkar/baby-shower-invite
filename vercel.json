{
  "buildCommand": "",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/rsvp", "destination": "/api/rsvp" },
    { "source": "/api/rsvps/count", "destination": "/api/rsvps-count" }
  ],
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node@3",
      "excludeFiles": "server.js"
    }
  }
}
